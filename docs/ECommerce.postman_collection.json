{
  "info": {
    "name": "Enterprise E-Commerce REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5201"
    },
    {
      "key": "email",
      "value": "customer@example.test"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Register customer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer@example.test\",\n  \"password\": \"LocalTestPassword1\"\n}"
        }
      }
    },
    {
      "name": "Log in",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login returns a bearer token', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Create product (admin)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/products",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"price\": 899,\n  \"stock\": 20\n}"
        }
      }
    },
    {
      "name": "Update product (admin)",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Desk Lamp\",\n  \"price\": 899,\n  \"stock\": 20\n}"
        }
      }
    },
    {
      "name": "Get product",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Set cart quantity",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/cart/{{productId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 2\n}"
        }
      }
    },
    {
      "name": "View cart",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cart"
      }
    },
    {
      "name": "Checkout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders"
      }
    },
    {
      "name": "Order history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders"
      }
    }
  ]
}